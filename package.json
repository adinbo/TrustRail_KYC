{
  "name": "trustrail-kyc",
  "version": "0.1.0",
  "private": true,
  "description": "TrustRail KYC module — identity verification (NIA + a swappable vendor: Smile ID or QoreID) and sanctions screening, standalone before integration into CediRamp",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "example": "tsx examples/verify-example.ts",
    "diagnostics": "tsx src/cli/diagnostics.ts",
    "serve": "tsx src/server.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "smile-identity-core": "^3.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
