# Copy to .env and fill in. Never commit the real file.

# Which identity vendor fills the biometric/registry check slot: "smile",
# "qoreid", or "mock". QoreID was added because Smile ID's signup form
# rejects gmail.com addresses. "mock" (added 2026-08-16) exists because
# QoreID's Ghana Card product couldn't produce a genuine verified:true with
# any data tried (real Ghana Card included) and their NIN product 403'd
# even after subscribing — see PLAN.md's "QoreID integration" section for
# the full trail. Use "mock" to unblock testing everything downstream of
# identity verification; swap back to a real vendor before anything
# resembling production use. Only the chosen vendor's credentials below
# need to be set (mock needs none).
KYC_VENDOR=smile

# --- Smile ID (used when KYC_VENDOR=smile) ---
# From the Smile Identity Portal after free sandbox signup.
SMILE_PARTNER_ID=
SMILE_API_KEY=
# 0 = sandbox, 1 = production. Always 0 until this module is production-ready
# and CediRamp itself is ready for real identity verification.
SMILE_SERVER=0

# --- QoreID (used when KYC_VENDOR=qoreid) ---
# From the QoreID dashboard after signup.
QOREID_CLIENT_ID=
QOREID_CLIENT_SECRET=
# Leave unset to use QoreID's default host (https://api.qoreid.com) — see
# src/qoreid/client.ts for what is and isn't confirmed about sandbox vs.
# production behavior on their side.
QOREID_BASE_URL=

# Only "mock" is supported this pass — see PLAN.md for why (no public NIA
# sandbox exists yet; real integration is gated behind NIA's own enterprise
# onboarding process).
NIA_MODE=mock

# --- Sanctions/PEP screening ---
# "mock" (always passes, exercises the plumbing only) or "opensanctions"
# (real, against OpenSanctions' matching API — sanctions/PEP/watchlists).
SANCTIONS_MODE=mock
# From opensanctions.org after signup (free trial with a business email).
OPENSANCTIONS_API_KEY=
# Leave unset to use OpenSanctions' default host (https://api.opensanctions.org).
OPENSANCTIONS_BASE_URL=
